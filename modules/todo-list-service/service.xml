<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder dependency-injector="spring" package-path="br.com.seatecnologia.todolist">
    <author>Carlos</author>
    <namespace>SEA</namespace>

   <entity local-service="true" name="Task" remote-service="false" uuid="true">
        <column name="taskId" primary="true" type="long" />
        <column name="groupId" type="long" />
        <column name="companyId" type="long" />
        <column name="userId" type="long" />
        <column name="userName" type="String" />
        <column name="createDate" type="Date" />
        <column name="modifiedDate" type="Date" />

        <column name="title" type="String" />
        <column name="description" type="String" />
        <column name="isCompleted" type="boolean" />
        <column name="isDeleted" type="boolean" /> <column name="dueDate" type="Date" />
        <column name="imageId" type="long" />

        <order by="asc">
            <order-column name="dueDate" />
            <order-column name="createDate" />
        </order>

        <finder name="UserActiveTasks" return-type="Collection">
            <finder-column name="groupId" />
            <finder-column name="userId" />
            <finder-column name="isDeleted" /> </finder>
        <finder name="UserHistoryTasks" return-type="Collection">
            <finder-column name="groupId" />
            <finder-column name="userId" />
            </finder>
    </entity>
    
    <entity local-service="true" name="Subtask" remote-service="false" uuid="true">
        <column name="subtaskId" primary="true" type="long" />
        
        <column name="taskId" type="long" />
        
        <column name="createDate" type="Date" />
        <column name="modifiedDate" type="Date" />

        <column name="title" type="String" />
        <column name="isCompleted" type="boolean" />

        <finder name="TaskSubtasks" return-type="Collection">
            <finder-column name="taskId" />
        </finder>
    </entity>


    <entity local-service="true" name="Category" remote-service="false" uuid="true">
        <column name="categoryId" primary="true" type="long" />
        <column name="groupId" type="long" />
        <column name="companyId" type="long" />
        <column name="userId" type="long" />
        <column name="userName" type="String" />
        <column name="createDate" type="Date" />
        <column name="modifiedDate" type="Date" />
        
        <column name="name" type="String" />
        
        <finder name="UserCategories" return-type="Collection">
            <finder-column name="groupId" />
            <finder-column name="userId" />
        </finder>
    </entity>

    <entity local-service="true" name="Comment" remote-service="false" uuid="true">
        <column name="commentId" primary="true" type="long" />
        <column name="groupId" type="long" />
        <column name="companyId" type="long" />
        <column name="userId" type="long" />
        <column name="userName" type="String" />
        <column name="createDate" type="Date" />
        <column name="modifiedDate" type="Date" />
        
        <column name="taskId" type="long" />
        <column name="text" type="String" />
        
        <finder name="TaskComments" return-type="Collection">
            <finder-column name="taskId" />
        </finder>
    </entity>
</service-builder>